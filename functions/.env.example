# Copy to functions/.env.<your-project-id> (that file is git-ignored).
# These are non-secret deploy parameters. Never put credentials here.

# Payment verification adapter. Only "none" is implemented (see docs/VERIFICATION.md).
VERIFICATION_PROVIDER=none

# Max single UPI payment in paise (10000000 = INR 1,00,000).
UPI_MAX_AMOUNT_MINOR=10000000

# Put the internal payment reference in the intent's `tr` when the QR has none.
# Leave false unless you have confirmed your target UPI apps accept it for the payee type.
UPI_ATTACH_INTERNAL_REF=false

# Secrets for a future verification provider go in Secret Manager, e.g.:
#   firebase functions:secrets:set PROVIDER_API_KEY
# and are declared with defineSecret() in that adapter. Example only:
# PROVIDER_API_KEY=<set via Secret Manager, not here>
